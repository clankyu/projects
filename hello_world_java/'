    public static boolean isLeapYear(int year) {
        if (year < 0) {
            return false;
        }

        if (year % 4 == 0 && year % 100 != 0) {
            return true;
        } else if (year % 400 == 0) {
            return true;
        } else {
            return false;
        }
    }

    public static double calculateDiscount(double amount) {
        if (amount > 100) {
            System.out.println(amount * 0.9);
            return amount * 0.9f;
        } else if (amount > 50) {
            System.out.println(amount * 0.95);
            return amount * 0.95f;
        } else {
            System.out.println(amount);
            return amount;
        }
    }

